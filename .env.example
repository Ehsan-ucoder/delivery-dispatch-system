# Docker Compose (see README): Postgres on 5433, Redis on 6380
DATABASE_URL=postgres://dispatch:dispatch@localhost:5433/dispatch
REDIS_URL=redis://127.0.0.1:6380
# Without Docker (typical Homebrew): use 5432 and 6379, create DB `dispatch`, use your OS user:
# DATABASE_URL=postgres://YOUR_USERNAME@localhost:5432/dispatch
# REDIS_URL=redis://127.0.0.1:6379
PORT=4000
WEBHOOK_SHARED_SECRET=change-me-for-callback-auth
ORDER_CREATE_RATE_LIMIT_WINDOW_MS=60000
ORDER_CREATE_RATE_LIMIT_MAX=30
